{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///d%3A/TOTVS%2012/Microsiga/Protheus/ProjetoVSCode/07_FINANCEIRO/SE5FI070.PRW","languageId":"advpl","version":1,"text":"#INCLUDE \"rwmake.ch\"\r\n#INCLUDE \"protheus.ch\"\r\n#INCLUDE \"topconn.ch\"          \r\n\r\n/*\r\nPrograma ...: SE5FI070() \r\nUso ........: Grava dados adicionais na SE5 para contabilização\r\nData .......: 23/06/2021\r\nFeito por ..: Bruno Lage Ferreira\r\nCopyright @1998-2001,2021\r\n\r\nE5_XTXFAT\r\nE1_XSEQABA\r\nE1_XSEQABA \r\n*/\r\nUser Function SE5FI070()\r\n***********************************************************************************\r\n*\r\n*\r\n***\r\nLocal aArea := GetArea()\r\n\r\ndbSelectArea(\"SE5\")\r\nSE5->(RecLock(\"SE5\",.F.))\r\n    E5_XTXFAT := SE1->E1_TXMOEDA\r\n    //E5_XVLAB  := Round(SE1->E1_TXMOEDA * SomaAbat(SE1->E1_PREFIXO,SE1->E1_NUM,SE1->E1_PARCELA,\"R\",SE1->E1_MOEDA,dDataBase,SE1->E1_CLIENTE,SE1->E1_LOJA),2)\r\nSE5->(MsUnlock()) \r\n\r\n\r\ndbSelectArea(\"SE1\")\r\nSE1->(RecLock(\"SE1\",.F.))\r\n    E1_XSEQABA := SE5->E5_SEQ\r\nSE1->(MsUnlock()) \r\n\r\nRestArea(aArea)\r\n\r\nReturn()\r\n\r\n\r\n/*\r\nPrograma ...: FA110SE5() \r\nUso ........: Grava dados adicionais na SE5 para contabilização baixa por LOTE\r\nData .......: 24/06/2021\r\nFeito por ..: Bruno Lage Ferreira\r\nCopyright @1998-2001,2021\r\n*/\r\nUser Function FA110SE5()\r\n***********************************************************************************\r\n*\r\n*\r\n***\r\nLocal aArea := GetArea()\r\n\r\ndbSelectArea(\"SE5\")\r\nSE5->(RecLock(\"SE5\",.F.))\r\n    E5_XTXFAT := SE1->E1_TXMOEDA\r\n    //E5_XVLAB  := Round(SE1->E1_TXMOEDA * SomaAbat(SE1->E1_PREFIXO,SE1->E1_NUM,SE1->E1_PARCELA,\"R\",SE1->E1_MOEDA,dDataBase,SE1->E1_CLIENTE,SE1->E1_LOJA),2)\r\nSE5->(MsUnlock()) \r\n\r\n\r\ndbSelectArea(\"SE1\")\r\nSE1->(RecLock(\"SE1\",.F.))\r\n    E1_XSEQABA := SE5->E5_SEQ\r\nSE1->(MsUnlock()) \r\n\r\nRestArea(aArea)\r\n\r\nReturn()\r\n\r\n\r\n"}}}
