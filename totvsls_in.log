{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///d%3A/TOTVS%2012/Microsiga/Protheus/ProjetoVSCode/06_FATURAMENTO/RETPESOFAT.PRW","languageId":"advpl","version":1,"text":"#INCLUDE \"rwmake.ch\"\r\n#INCLUDE \"protheus.ch\"\r\n#INCLUDE \"TOPCONN.CH\"\r\n\r\n/*                                          \r\nPrograma ...: RETPESOFAT.Prw\r\nUso ........: Endereçamento\r\nData .......: 20/09/19\r\nFeito por ..: Bruno Lage Ferreira.\r\n*/\r\n\r\nUser Function RETPESOFAT(cNumPedVen, cItemPv )  \r\n************************************************************************************\r\n*\r\n*\r\n***\r\nLocal nPesoIdeal := 0\r\nLocal cQuery     := \"\"\r\n\r\ncQuery     := \" SELECT\tC6_PRODUTO,C6_XPESO PESOAMOSTRA, \r\ncQuery     += \" \t\tISNULL((SELECT TOP 1 B8_YPESOLQ FROM SB8010 WHERE D_E_L_E_T_ = '' AND B8_PRODUTO = C6_PRODUTO AND B8_LOTECTL = C6_LOTECTL AND B8_NUMLOTE = C6_NUMLOTE AND B8_YPESOLQ <> 0 ),0) PESOLQ\r\ncQuery     += \"   FROM SC6010 \r\ncQuery     += \"  WHERE D_E_L_E_T_ = '' \r\ncQuery     += \"    AND C6_NUM     = '\"+cNumPedVen+\"' \r\ncQuery     += \"    AND C6_ITEM    = '\"+cItemPv+\"' \r\n\r\nTcQuery cQuery Alias TRB New\r\n\r\ndbSelectArea(\"TRB\")\r\ndbGoTop()\t\r\nWhile (!Eof())\r\n\r\n\tnPesoIdeal := IIF( LEFT(TRB->C6_PRODUTO,2)$\"AM/BL\" , TRB->PESOAMOSTRA , TRB->PESOLQ )\r\n\r\n\tdbSelectArea(\"TRB\")\r\n\tdbSkip()\r\nEndDo\r\n\r\ndbSelectArea(\"TRB\")\r\ndbCloseArea()\r\n\r\nReturn(nPesoIdeal) "}}}
