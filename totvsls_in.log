{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///d%3A/TOTVS%2012/Microsiga/Protheus/ProjetoVSCode/03_CONEX%C3%83ONFE/MT140CAB.PRW","languageId":"advpl","version":1,"text":"/* ####################################################################### *\\\r\n|| #           PONTO DE ENTRADA UTILIZADO PELO IMPORTADOR GATI           # ||\r\n|| #                                                                     # ||\r\n|| #    É EXECUTADO QUANDO A PRÉ-NOTA ESTÁ SENDO INCLUÍDA PARA COLOCAR   # ||\r\n|| #     OS VALORES REFERENTES AS DESPESAS CONTIDAS NO XML               # ||\r\n\\* ####################################################################### */\r\n\r\nUser Function MT140CAB()\r\n\tU_GTPE009()\t\r\nReturn .T."}}}
