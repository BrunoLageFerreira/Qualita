{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///d%3A/TOTVS%2012/Microsiga/Protheus/ProjetoVSCode/03_CONEX%C3%83ONFE/MT103CWH.PRW","languageId":"advpl","version":1,"text":"/* ####################################################################### *\\\r\n|| #           PONTO DE ENTRADA UTILIZADO PELO IMPORTADOR GATI           # ||\r\n|| #                                                                     # ||\r\n|| # PONTO DE ENTRADA QUE PERMITE ALTERAR O WHEN DOS CAMPOS DE CABEÇALHO # ||\r\n|| #                         DA PRÉ-NOTA E NOTA                          # ||\r\n\\* ####################################################################### */\r\n\r\nUser Function MT103CWH()\r\n\tLocal lRet:= .T.\r\n\r\n\tlRet:= U_GTPE006()\r\n\r\nReturn lRet"}}}
