{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///d%3A/TOTVS%2012/Microsiga/Protheus/ProjetoVSCode/03_CONEX%C3%83ONFE/FISMNTNFE.PRW","languageId":"advpl","version":1,"text":"#include \"rwmake.ch\"\r\n\r\n// ############################################################################################\r\n// Projeto: \r\n// Modulo : Faturamento\r\n// Fonte  : FISMNTNFE\r\n// ---------+----------------------+-----------------------------------------------------------\r\n// Data     | Autor                | Descricao\r\n// ---------+----------------------+-----------------------------------------------------------\r\n// 19/08/16 | Evaldo Cevinscki Jr. | P.E. para disparar o envio das nfes para conexão nfe\r\n// ---------+----------------------+-----------------------------------------------------------\r\nUser Function FISMNTNFE()\r\n\tLocal aArea := GetArea()\r\n\tLocal cIdNfe\t:= PARAMIXB[1]\r\n\tLocal aNfeInf\t:= PARAMIXB[2]\r\n\tLocal cCodRetNfe:= aNfeInf[1][9]                     \t\t\t\r\n\r\n\tIf cCodRetNfe  == \"100\"\r\n\t\t//U_GATI007()\r\n\tEndif\r\n\r\n\tRestArea(aArea)\r\n\r\nReturn \r\n"}}}
