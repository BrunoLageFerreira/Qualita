{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///d%3A/TOTVS%2012/Microsiga/Protheus/ProjetoVSCode/03_CONEX%C3%83ONFE/A103CND2.prw","languageId":"advpl","version":1,"text":"/* ####################################################################### *\\\r\n|| #           PONTO DE ENTRADA UTILIZADO PELO IMPORTADOR GATI           # ||\r\n|| #                                                                     # ||\r\n|| #    ESTE PONTO DE ENTRADA É UTILIZADO PARA ALTERAR A CONDIÇÃO DE     # ||\r\n|| #                 PAGAMENTO NA NOTA FISCAL DE ENTRADA                 # ||\r\n\\* ####################################################################### */\r\n\r\nUser Function A103CND2()\r\n\tU_GTPE001()\r\nReturn Nil"}}}
